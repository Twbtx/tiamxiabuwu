local function addConnection(conn)
    if conn and type(conn.Disconnect) == "function" then
        table.insert(_G.AutoScript.connections, conn)
    end
    return conn
end

local function addTask(task)
    if task and type(task) == "thread" then
        table.insert(_G.AutoScript.tasks, task)
    end
    return task
end

