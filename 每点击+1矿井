local statusPara = wallCategory:Paragraph({
    Title = "状态",
    Icon = "eye"
})
local statusLabel = statusPara.ContentLabel
statusLabel.Text = "未检测到层级（可能在空中）"

local function updateStatus(stage, sub)
    if statusLabel then
        if stage and sub then
            statusLabel.Text = string.format("当前层级：%d - %d", stage, sub)
        else
            statusLabel.Text = "未检测到层级（可能在空中）"
        end
    end
end

local function getCurrentStage()
    local char = game.Players.LocalPlayer.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end
    local origin = root.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(origin, Vector3.new(0, -1, 0) * 5, raycastParams)
    if not result then return nil, nil end
    local hitPart = result.Instance
    if not hitPart then return nil, nil end

    local stageNum, subStageNum = nil, nil
    local current = hitPart
    while current do
        if current.Parent and current.Parent.Name == "Stages" then
            local parentStage = current.Parent.Parent
            if parentStage and parentStage.Name and parentStage.Name:match("^Stage %d+$") then
                local stageStr = parentStage.Name:match("^Stage (%d+)$")
                if stageStr then
                    stageNum = tonumber(stageStr)
                    local subName = current.Name
                    local subNum = tonumber(subName)
                    if subNum then
                        subStageNum = subNum
                        break
                    end
                end
            end
        end
        current = current.Parent
    end

    if not stageNum or not subStageNum then
        local parentStage = hitPart.Parent
        if parentStage and parentStage.Name and parentStage.Name:match("^Stage %d+$") then
            local stageStr = parentStage.Name:match("^Stage (%d+$)")
            if stageStr then
                stageNum = tonumber(stageStr)
                local stagesFolder = parentStage:FindFirstChild("Stages")
                if stagesFolder then
                    local children = stagesFolder:GetChildren()
                    if #children > 0 then
                        local firstSub = children[1].Name
                        local subNum = tonumber(firstSub)
                        if subNum then
                            subStageNum = subNum
                        end
                    end
                end
                if subStageNum then
                    return stageNum, subStageNum
                else
                    return nil, nil
                end
            end
        end
    end

    if stageNum and subStageNum then
        return stageNum, subStageNum
    end
    return nil, nil
end

