local wallV2Category = wallTab:Category({ Title = "自动打墙V2（顺序扫描+停留）", IconName = "refresh-cw" })

local wallV2Running = false
local wallV2Conn = nil
local scanMain = 1
local scanSub = 1
local maxMain = 100
local maxSub = 3
local useTransparency = true

local statusV2Para = wallV2Category:Paragraph({
    Title = "V2 状态",
    Icon = "clock"
})
local statusV2Label = statusV2Para.ContentLabel
statusV2Label.Text = "未启动"

local function getStagePart(main, sub)
    local stageFolder = workspace:FindFirstChild("Stages")
    if not stageFolder then return nil end
    local mainStage = stageFolder:FindFirstChild("Stage " .. main)
    if not mainStage then return nil end
    local subFolder = mainStage:FindFirstChild("Stages")
    if not subFolder then return nil end
    return subFolder:FindFirstChild(tostring(sub))
end

local function isValid(part)
    if not part then return false end
    if useTransparency then
        return part.Transparency < 1
    else
        return part.CanCollide == true
    end
end

local function updateStatusV2(main, sub, state)
    if statusV2Label then
        local mode = useTransparency and "透明度" or "CanCollide"
        if state == "active" then
            statusV2Label.Text = string.format("【%s】正在攻击：主层 %d - 子层 %d", mode, main, sub)
        elseif state == "search" then
            statusV2Label.Text = string.format("【%s】搜索中：主层 %d - 子层 %d", mode, main, sub)
        else
            statusV2Label.Text = "已停止"
        end
    end
end

