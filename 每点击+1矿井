local noclipEnabled = false
local noclipConn = nil
local noclipBackup = {}
playerCategory:Toggle({
    Title = "穿墙 (Noclip)",
    Value = false,
    FeatureName = "穿墙",
    Icon = "box",
    ConfigKey = "noclip",
    Tooltip = "开启后角色可穿过墙体，关闭恢复原始碰撞",
    Callback = function(state)
        noclipEnabled = state
        if state then
            noclipBackup = {}
            local char = game.Players.LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        table.insert(noclipBackup, {part, part.CanCollide})
                        part.CanCollide = false
                    end
                end
            end
            if noclipConn then noclipConn:Disconnect() end
            noclipConn = addConnection(game:GetService("RunService").Heartbeat:Connect(function()
                if not noclipEnabled then return end
                local char = game.Players.LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end))
        else
            if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
            for _, data in ipairs(noclipBackup) do
                local part = data[1]
                if part and part.Parent then
                    part.CanCollide = data[2]
                end
            end
            noclipBackup = {}
        end
    end
})

