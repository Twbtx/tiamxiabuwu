-- ===== 手动传送与坐标工具 =====
local function parseCoordinates(input)
    local parts = {}
    for token in string.gmatch(input, "[^,]+") do
        local num = tonumber(token:match("^%s*(.-)%s*$"))
        if num then
            table.insert(parts, num)
        else
            return nil, "无效数字: " .. token
        end
    end
    local x, y, z = 0, 0, 0
    if #parts >= 1 then x = parts[1] end
    if #parts >= 2 then y = parts[2] end
    if #parts >= 3 then z = parts[3] end
    return Vector3.new(x, y, z), nil
end

local function manualTeleport()
    CreateTextInputPopup("手动传送坐标", "输入 x,y,z (例如 123,456,789 或 123,456)", function(input)
        local pos, err = parseCoordinates(input)
        if not pos then
            ShowNotification("解析错误: " .. err, Color3.fromRGB(255, 50, 50))
            return
        end
        local char = player.Character
        if not char then
            ShowNotification("角色未找到", Color3.fromRGB(255, 50, 50))
            return
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            ShowNotification("未找到HumanoidRootPart", Color3.fromRGB(255, 50, 50))
            return
        end
        hrp.CFrame = CFrame.new(pos)
        ShowNotification(string.format("已传送到 (%.2f, %.2f, %.2f)", pos.X, pos.Y, pos.Z), Color3.fromRGB(0, 255, 100))
    end)
end

