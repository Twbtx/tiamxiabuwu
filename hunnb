local function ShowNotification(message, color, duration)
    color = color or Color3.fromRGB(0, 150, 255)
    duration = duration or NotificationSettings.Duration
    if _G.NotificationGui then _G.NotificationGui:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Parent = player:WaitForChild("PlayerGui")
    gui.ResetOnSpawn = false
    gui.Name = "CustomNotification"
    _G.NotificationGui = gui

    local container = Instance.new("Frame")
    container.Parent = gui
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true

    local frame = Instance.new("Frame")
    frame.Parent = container
    frame.Size = UDim2.new(0, NotificationSettings.Width, 0, NotificationSettings.Height)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    frame.BackgroundTransparency = 0

    local corner = Instance.new("UICorner")
    corner.Parent = frame
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Parent = frame
    stroke.Color = color
    stroke.Thickness = 2

    local text = Instance.new("TextLabel")
    text.Parent = frame
    text.Size = UDim2.new(1, -20, 1, -10)
    text.Position = UDim2.new(0, 10, 0, 5)
    text.BackgroundTransparency = 1
    text.Text = message
    text.TextColor3 = Color3.fromRGB(220, 220, 255)
    text.TextSize = NotificationSettings.TextSize
    text.Font = Enum.Font.Gotham
    text.TextWrapped = true
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextYAlignment = Enum.TextYAlignment.Top

    local margin = 10
    local w = NotificationSettings.Width
    local h = NotificationSettings.Height
    local startPos, endPos
    if NotificationSettings.Position == "TopLeft" then
        startPos = UDim2.new(0, margin, 0, -h - margin)
        endPos = UDim2.new(0, margin, 0, margin)
    elseif NotificationSettings.Position == "TopRight" then
        startPos = UDim2.new(1, -w - margin, 0, -h - margin)
        endPos = UDim2.new(1, -w - margin, 0, margin)
    elseif NotificationSettings.Position == "BottomLeft" then
        startPos = UDim2.new(0, margin, 1, margin)
        endPos = UDim2.new(0, margin, 1, -h - margin)
    elseif NotificationSettings.Position == "BottomRight" then
        startPos = UDim2.new(1, -w - margin, 1, margin)
        endPos = UDim2.new(1, -w - margin, 1, -h - margin)
    else
        startPos = UDim2.new(0, margin, 0, -h - margin)
        endPos = UDim2.new(0, margin, 0, margin)
    end
    frame.Position = startPos
    local tweenIn = TweenService:Create(frame, TweenInfo.new(NotificationSettings.PopSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = endPos})
    tweenIn:Play()
    task.delay(duration, function()
        if not frame.Parent then return end
        local tweenOut = TweenService:Create(frame, TweenInfo.new(NotificationSettings.RetractSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = startPos})
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            gui:Destroy()
            _G.NotificationGui = nil
        end)
    end)
end

