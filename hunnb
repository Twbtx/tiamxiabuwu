local function randomOffset()
    local angle = math.random() * math.pi * 2
    local dist = math.random() * SupaTech.RandomRadius
    return Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
end

local function isPlayingAnim(hum, animId)
    if not hum then return false end
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        local anim = track.Animation
        if anim then
            local id = anim.AnimationId
            if id and string.find(id, animId) then return true end
        end
    end
    return false
end

local function getNearestEnemy()
    local char = player.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end
    local nearest = nil
    local nearestRoot = nil
    local nearestDist = math.huge
    local myPos = root.Position
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local oChar = other.Character
            if oChar then
                local oRoot = oChar:FindFirstChild("HumanoidRootPart")
                if oRoot then
                    local dist = (myPos - oRoot.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = oChar
                        nearestRoot = oRoot
                    end
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            local hum = obj:FindFirstChild("Humanoid")
            local oRoot = obj:FindFirstChild("HumanoidRootPart")
            if hum and oRoot then
                local dist = (myPos - oRoot.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = obj
                    nearestRoot = oRoot
                end
            end
        end
    end
    if nearest and nearestRoot then
        return nearest, nearestRoot
    end
    return nil, nil
end

local function doDash()
    local char = player.Character
    if not char then return end
    local comm = char:FindFirstChild("Communicate")
    if comm then
        local args = {
            {
                Dash = Enum.KeyCode.W,
                Key = Enum.KeyCode.Q,
                Goal = "KeyPress",
                MousePos = CFrame.new(-36.971492767333984, 438.15667724609375, 86.00199127197266, -0.9908232092857361, -0.0044507840648293495, 0.1350911408662796, -4.656612873077393e-10, 0.999457836151123, 0.03292866051197052, -0.13516442477703094, 0.03262647986412048, -0.9902859330177307)
            }
        }
        comm:FireServer(unpack(args))
        SupaTech.IsCooldown = true
        SupaTech.CooldownEndTime = tick() + SupaTech.CooldownTime
    end
end

local function updateSupaCooldown()
    if SupaTech.IsCooldown then
        local remaining = SupaTech.CooldownEndTime - tick()
        if remaining <= 0 then SupaTech.IsCooldown = false end
    end
    if SupaStatusLabel then
        if SupaTech.IsCooldown then
            local remaining = SupaTech.CooldownEndTime - tick()
            if remaining > 0 then
                SupaStatusLabel.Text = string.format("冷却:%.1f秒", remaining)
                SupaStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            else
                SupaStatusLabel.Text = "就绪"
                SupaStatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
            end
        else
            SupaStatusLabel.Text = "就绪"
            SupaStatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        end
    end
end

local function startTeleportLoop(enemyChar, enemyRoot)
    local startTime = tick()
    local myChar = player.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myHum = myChar:FindFirstChild("Humanoid")
    if not myHum then return end
    local enemyHum = enemyChar:FindFirstChild("Humanoid")
    if not enemyHum then return end
    myHum.PlatformStand = true
    local fixedOffset = randomOffset()
    local myPos = myRoot.Position
    local enemyPos = enemyRoot.Position
    local dirToEnemy = (enemyPos - myPos).Unit
    local facePos = enemyPos - dirToEnemy * SupaTech.FaceDistance
    facePos = Vector3.new(facePos.X, enemyPos.Y, facePos.Z)
    myRoot.CFrame = CFrame.new(facePos + fixedOffset) * CFrame.Angles(math.rad(SupaTech.UpwardAngle), 0, 0)
    task.wait(0.1)
    local footPos = enemyRoot.Position - Vector3.new(0, SupaTech.TeleportOffset, 0)
    myRoot.CFrame = CFrame.new(footPos + fixedOffset) * CFrame.Angles(math.rad(SupaTech.UpwardAngle), 0, 0)
    while tick() - startTime < SupaTech.TeleportDuration do
        if not SupaTech.Enabled then break end
        if not enemyRoot or not enemyRoot.Parent then break end
        if not myRoot or not myRoot.Parent then break end
        if not myHum then break end
        local currentEnemyHum = enemyChar:FindFirstChild("Humanoid")
        if not currentEnemyHum then break end
        if isPlayingAnim(currentEnemyHum, SupaTech.EndAnimId) or isPlayingAnim(currentEnemyHum, SupaTech.RagdollAnimId) then break end
        local newFootPos = enemyRoot.Position - Vector3.new(0, SupaTech.TeleportOffset, 0)
        myRoot.CFrame = CFrame.new(newFootPos + fixedOffset) * CFrame.Angles(math.rad(SupaTech.UpwardAngle), 0, 0)
        task.wait()
    end
    if enemyRoot and enemyRoot.Parent and myRoot and myRoot.Parent then
        local finalFootPos = enemyRoot.Position - Vector3.new(0, SupaTech.VerticalOffset, 0)
        myRoot.CFrame = CFrame.new(finalFootPos + fixedOffset) * CFrame.Angles(math.rad(SupaTech.UpwardAngle), 0, 0)
    end
    myHum.PlatformStand = false
end

local function executeSupaTech()
    if SupaTech.IsExecuting then return end
    if SupaTech.IsCooldown then return end
    SupaTech.IsExecuting = true
    local enemyChar, enemyRoot = getNearestEnemy()
    if not enemyChar or not enemyRoot then
        SupaTech.IsExecuting = false
        return
    end
    local enemyHumCheck = enemyChar:FindFirstChild("Humanoid")
    if enemyHumCheck and (isPlayingAnim(enemyHumCheck, SupaTech.RagdollAnimId) or isPlayingAnim(enemyHumCheck, SupaTech.EndAnimId)) then
        SupaTech.IsExecuting = false
        return
    end
    task.wait(SupaTech.WaitBeforeAction)
    if not enemyChar.Parent or not enemyRoot.Parent then
        SupaTech.IsExecuting = false
        return
    end
    local enemyHum2 = enemyChar:FindFirstChild("Humanoid")
    if enemyHum2 and (isPlayingAnim(enemyHum2, SupaTech.RagdollAnimId) or isPlayingAnim(enemyHum2, SupaTech.EndAnimId)) then
        SupaTech.IsExecuting = false
        return
    end
    doDash()
    startTeleportLoop(enemyChar, enemyRoot)
    SupaTech.IsExecuting = false
end

local function ToggleSupaTech()
    SupaTech.Enabled = not SupaTech.Enabled
    UpdateToggleButton(SupaTechButton, SupaTech.Enabled, "SupaTech:开启", "SupaTech:关闭")
    if SupaTech.Enabled then
        ShowNotification("Supa Tech 已启用", Color3.fromRGB(0, 255, 100))
    else
        ShowNotification("Supa Tech 已禁用", Color3.fromRGB(255, 100, 0))
        SupaTech.IsExecuting = false
    end
end

-- ===== AntiFling (修复残留 & 恢复原始碰撞) =====
local AntiFling = {
    Enabled = false,
    MaxLinear = 200,
    MaxAngular = 100,
    SafeCFrame = nil,
    BodyMovers = {"BodyVelocity", "BodyAngularVelocity", "BodyForce", "BodyThrust", "BodyPosition", "BodyGyro"},
    Conns = {},
    HeartbeatCon = nil,
    OriginalCanCollide = {},
    RestoreTask = nil,
}

local function RecordOriginalCollide()
    local char = player.Character
    if not char then return end
    AntiFling.OriginalCanCollide = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            AntiFling.OriginalCanCollide[part] = part.CanCollide
        end
    end
end

local function RestoreOriginalCollide()
    if AntiFling.RestoreTask then
        task.cancel(AntiFling.RestoreTask)
        AntiFling.RestoreTask = nil
    end
    for part, original in pairs(AntiFling.OriginalCanCollide) do
        if part and part.Parent then
            part.CanCollide = original
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
        end
    end
    AntiFling.OriginalCanCollide = {}
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
            end
        end
    end
end

local function FlingNeutralize()
    if not AntiFling.Enabled then return end
    local char = player.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if table.find(AntiFling.BodyMovers, obj.ClassName) then
            pcall(function() obj:Destroy() end)
        end
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and AntiFling.SafeCFrame then
        root.CFrame = AntiFling.SafeCFrame
        char:SetPrimaryPartCFrame(AntiFling.SafeCFrame)
    end
    if AntiFling.RestoreTask then
        task.cancel(AntiFling.RestoreTask)
    end
    AntiFling.RestoreTask = task.delay(0.4, function()
        if char and char.Parent then
            for part, original in pairs(AntiFling.OriginalCanCollide) do
                if part and part.Parent then
                    part.CanCollide = original
                end
            end
        end
        AntiFling.RestoreTask = nil
    end)
    ShowNotification("检测到被甩飞，已 neutralize", Color3.fromRGB(255, 100, 0))
end

local function WatchBodyMovers(char)
    local con = char.DescendantAdded:Connect(function(child)
        if not AntiFling.Enabled then return end
        if table.find(AntiFling.BodyMovers, child.ClassName) then
            child:Destroy()
            ShowNotification("拦截异常 " .. child.ClassName, Color3.fromRGB(255, 100, 0))
            FlingNeutralize()
        end
    end)
    table.insert(AntiFling.Conns, con)
end

local function AntiFlingHeartbeat()
    if not AntiFling.Enabled then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local linear = root.AssemblyLinearVelocity.Magnitude
    local angular = root.AssemblyAngularVelocity.Magnitude
    if linear < 60 and angular < 40 then
        AntiFling.SafeCFrame = root.CFrame
    end
    if linear > AntiFling.MaxLinear or angular > AntiFling.MaxAngular then
        FlingNeutralize()
    end
end

local function SetupAntiFling(char)
    for _, con in ipairs(AntiFling.Conns) do
        pcall(function() con:Disconnect() end)
    end
    AntiFling.Conns = {}
    task.wait(0.3)
    if char and char.Parent then
        WatchBodyMovers(char)
        if AntiFling.Enabled then
            RecordOriginalCollide()
        end
    end
end

if player.Character then SetupAntiFling(player.Character) end
player.CharacterAdded:Connect(SetupAntiFling)

AntiFling.HeartbeatCon = RunService.Heartbeat:Connect(AntiFlingHeartbeat)

local function ToggleAntiFling()
    AntiFling.Enabled = not AntiFling.Enabled
    UpdateToggleButton(AntiFlingButton, AntiFling.Enabled, "防甩飞:开启", "防甩飞:关闭")

    if AntiFling.Enabled then
        ShowNotification("防甩飞已启用", Color3.fromRGB(0, 255, 100))
        if not AntiFling.HeartbeatCon then
            AntiFling.HeartbeatCon = RunService.Heartbeat:Connect(AntiFlingHeartbeat)
        end
        local char = player.Character
        if char then SetupAntiFling(char) end
    else
        ShowNotification("防甩飞已禁用", Color3.fromRGB(255, 100, 0))
        if AntiFling.HeartbeatCon then
            AntiFling.HeartbeatCon:Disconnect()
            AntiFling.HeartbeatCon = nil
        end
        for _, con in ipairs(AntiFling.Conns) do
            pcall(function() con:Disconnect() end)
        end
        AntiFling.Conns = {}
        if AntiFling.RestoreTask then
            task.cancel(AntiFling.RestoreTask)
            AntiFling.RestoreTask = nil
        end
        RestoreOriginalCollide()
        AntiFling.SafeCFrame = nil
    end
end

