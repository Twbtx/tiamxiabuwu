local function Invis_Heartbeat()
    if not InvisData.enabled then return end
    if not InvisData.root or not InvisData.hum then return end
    local currentCFrame = InvisData.root.CFrame
    local currentOffset = InvisData.hum.CameraOffset
    local targetCFrame = currentCFrame * CFrame.new(InvisData.offset)
    local posOffset = targetCFrame:ToObjectSpace(CFrame.new(currentCFrame.Position)).Position
    InvisData.root.CFrame = targetCFrame
    InvisData.hum.CameraOffset = posOffset
    RunService.RenderStepped:Wait()
    InvisData.root.CFrame = currentCFrame
    InvisData.hum.CameraOffset = currentOffset
end
