-- ===== 隐身功能 =====
local function Invis_RefreshParts()
    InvisData.char = player.Character or player.CharacterAdded:Wait()
    InvisData.hum = InvisData.char:WaitForChild('Humanoid')
    InvisData.root = InvisData.char:WaitForChild('HumanoidRootPart')
    InvisData.parts = {}
    for _, part in ipairs(InvisData.char:GetDescendants()) do
        if part:IsA('BasePart') and part.Transparency == 0 then
            table.insert(InvisData.parts, part)
        end
    end
end

local function Invis_Toggle()
    InvisData.enabled = not InvisData.enabled
    for _, part in ipairs(InvisData.parts) do
        if part and part.Parent then
            part.Transparency = InvisData.enabled and 0.5 or 0
        end
    end
    UpdateToggleButton(InvisButton, InvisData.enabled, "隐身:开启", "隐身:关闭")
    ShowNotification(InvisData.enabled and "隐身已开启" or "隐身已关闭", InvisData.enabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 100, 0))
end

Invis_RefreshParts()
