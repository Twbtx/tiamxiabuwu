RunService.Heartbeat:Connect(function()
    if not SupaTech.Enabled then
        if SupaTech.IsExecuting then SupaTech.IsExecuting = false end
        return
    end
    if SupaTech.IsExecuting then return end
    if SupaTech.IsCooldown then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    if isPlayingAnim(hum, SupaTech.AnimId) then
        local enemyChar, enemyRoot = getNearestEnemy()
        if enemyChar and enemyRoot then
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                if dist <= SupaTech.NearbyRange then
                    local enemyHumCheck = enemyChar:FindFirstChild("Humanoid")
                    if not (enemyHumCheck and (isPlayingAnim(enemyHumCheck, SupaTech.RagdollAnimId) or isPlayingAnim(enemyHumCheck, SupaTech.EndAnimId))) then
                        task.spawn(executeSupaTech)
                    end
                end
            end
        end
    end
end)

